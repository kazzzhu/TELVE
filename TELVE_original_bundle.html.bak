700;\n  font-display: swap;\n  src: url(\"53f97e10-819e-4dfc-b0a9-7591f24a0c1f\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"59d17cdb-e86b-4c6f-9251-4475efaf621f\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"b1744bf2-cb04-406d-bea3-a8519569b50d\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"c45705b5-d332-4968-b16d-8fa90d5684a5\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"ffd7c6eb-f164-4cb5-917a-911a0814f5d0\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; background: #1a1c1f; }\n  a { color: inherit; text-decoration: none; }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"min-height:100vh;background:#1a1c1f;font-family:'Barlow',sans-serif;color:#eceff2;\">\n\n  <!-- ===== NAV ===== -->\n  <div style=\"position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:16px 56px;background:#141619;border-bottom:2px solid #f5b301;\">\n    <div sc-camel-on-click=\"{{ goInicio }}\" style=\"display:flex;align-items:baseline;gap:11px;cursor:pointer;\">\n      <span style=\"font-family:'Anton',sans-serif;font-size:28px;letter-spacing:0.04em;color:#fff;\">TELVE C.A.<\u002Fspan>\n      <span style=\"font-family:'Oswald',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#f5b301;font-weight:600;\">Electromec\u00e1nica<\u002Fspan>\n    <\u002Fdiv>\n    <button id=\"r-burger\" aria-label=\"Men\u00fa\" type=\"button\"><span><\u002Fspan><\u002Fbutton>\n    <div data-r-links style=\"display:flex;align-items:center;gap:30px;font-family:'Oswald',sans-serif;font-size:15px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;\">\n      <span sc-camel-on-click=\"{{ goInicio }}\" style=\"cursor:pointer;color:{{ cInicio }};\">Inicio<\u002Fspan>\n      <span sc-camel-on-click=\"{{ goServicios }}\" style=\"cursor:pointer;color:{{ cServicios }};\">Servicios<\u002Fspan>\n      <span sc-camel-on-click=\"{{ goNosotros }}\" style=\"cursor:pointer;color:{{ cNosotros }};\">Nosotros<\u002Fspan>\n      <span sc-camel-on-click=\"{{ goContacto }}\" style=\"cursor:pointer;color:{{ cContacto }};\">Contacto<\u002Fspan>\n      <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#04210f;font-family:'Barlow';font-weight:700;text-transform:none;letter-spacing:0;padding:11px 20px;border-radius:5px;\">WhatsApp<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <!-- ============================= INICIO ============================= -->\n  <sc-if value=\"{{ isInicio }}\" hint-placeholder-val=\"{{ true }}\">\n  <div>\n    <!-- hero -->\n    <div style=\"position:relative;padding:96px 56px 88px;background:linear-gradient(160deg,#26292e 0%,#1a1c1f 60%);\">\n      <div style=\"position:absolute;top:0;left:0;right:0;height:14px;background:repeating-linear-gradient(45deg,#f5b301,#f5b301 18px,#1a1c1f 18px,#1a1c1f 36px);\"><\u002Fdiv>\n      <div style=\"max-width:820px;\">\n        <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:20px;\">Taller electromec\u00e1nico \u00b7 desde 1975<\u002Fdiv>\n        <h1 style=\"font-family:'Anton',sans-serif;font-size:78px;line-height:0.98;font-weight:400;text-transform:uppercase;letter-spacing:0.005em;margin:0 0 22px;\">Reparamos lo que mueve tu operaci\u00f3n.<\u002Fh1>\n        <p style=\"font-size:20px;line-height:1.55;color:#b7bdc4;margin:0 0 36px;max-width:580px;\">Reparaci\u00f3n y mantenimiento de motores el\u00e9ctricos y equipos electromec\u00e1nicos. Trabajo de taller pesado, con atenci\u00f3n directa del due\u00f1o.<\u002Fp>\n        <div style=\"display:flex;gap:14px;\">\n          <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;gap:9px;background:#f5b301;color:#1a1c1f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:16px 30px;border-radius:5px;\">Cotiza por WhatsApp<\u002Fa>\n          <span sc-camel-on-click=\"{{ goServicios }}\" style=\"cursor:pointer;display:inline-flex;align-items:center;background:transparent;color:#eceff2;border:2px solid #3a3f45;font-family:'Oswald',sans-serif;font-weight:500;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:16px 30px;border-radius:5px;\">Ver servicios<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <!-- spec strip -->\n    <div style=\"display:grid;grid-template-columns:repeat(4,1fr);background:#141619;border-top:1px solid #2c3036;border-bottom:1px solid #2c3036;\">\n      <div style=\"padding:28px 56px;border-right:1px solid #2c3036;\"><div style=\"font-family:'Anton',sans-serif;font-size:36px;color:#f5b301;\">50+<\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#8a9098;\">A\u00f1os de taller<\u002Fdiv><\u002Fdiv>\n      <div style=\"padding:28px 40px;border-right:1px solid #2c3036;\"><div style=\"font-family:'Anton',sans-serif;font-size:36px;color:#f5b301;\">AC/DC<\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#8a9098;\">Todo motor<\u002Fdiv><\u002Fdiv>\n      <div style=\"padding:28px 40px;border-right:1px solid #2c3036;\"><div style=\"font-family:'Anton',sans-serif;font-size:36px;color:#f5b301;\">1:1<\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#8a9098;\">Atenci\u00f3n directa<\u002Fdiv><\u002Fdiv>\n      <div style=\"padding:28px 40px;\"><div style=\"font-family:'Anton',sans-serif;font-size:36px;color:#f5b301;\">HP<\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:#8a9098;\">Cualquier potencia<\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n    <!-- services preview -->\n    <div style=\"padding:80px 56px;max-width:1280px;margin:0 auto;\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:12px;\">Servicios<\u002Fdiv>\n      <h2 style=\"font-family:'Anton',sans-serif;font-size:46px;text-transform:uppercase;font-weight:400;margin:0 0 40px;letter-spacing:0.01em;\">Capacidad de taller<\u002Fh2>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:20px;\">\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:14px;\">01<\u002Fdiv>\n          <h3 style=\"font-family:'Oswald',sans-serif;font-size:23px;font-weight:600;text-transform:uppercase;margin:0 0 10px;\">Rebobinado de motores<\u002Fh3>\n          <p style=\"font-size:15px;color:#9aa1a9;line-height:1.55;margin:0;\">Reparaci\u00f3n y rebobinado de motores el\u00e9ctricos monof\u00e1sicos y trif\u00e1sicos.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:14px;\">02<\u002Fdiv>\n          <h3 style=\"font-family:'Oswald',sans-serif;font-size:23px;font-weight:600;text-transform:uppercase;margin:0 0 10px;\">Mantenimiento<\u002Fh3>\n          <p style=\"font-size:15px;color:#9aa1a9;line-height:1.55;margin:0;\">Preventivo y correctivo para reducir paradas y alargar la vida del equipo.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:14px;\">03<\u002Fdiv>\n          <h3 style=\"font-family:'Oswald',sans-serif;font-size:23px;font-weight:600;text-transform:uppercase;margin:0 0 10px;\">Equipos electromec\u00e1nicos<\u002Fh3>\n          <p style=\"font-size:15px;color:#9aa1a9;line-height:1.55;margin:0;\">Diagn\u00f3stico, pruebas y reparaci\u00f3n de sistemas electromec\u00e1nicos.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <span sc-camel-on-click=\"{{ goServicios }}\" style=\"cursor:pointer;display:inline-flex;margin-top:28px;align-items:center;gap:8px;color:#f5b301;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:15px;\">Ver todos los servicios \u2192<\u002Fspan>\n    <\u002Fdiv>\n    <!-- why us -->\n    <div style=\"display:grid;grid-template-columns:1fr 1.05fr;background:#141619;\">\n      <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);min-height:380px;display:flex;align-items:center;justify-content:center;\">\n        <span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;color:#7a828b;background:#141619cc;padding:8px 14px;border-radius:6px;\">foto \u00b7 maquinaria de taller<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"padding:76px 56px;display:flex;flex-direction:column;justify-content:center;\">\n        <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:16px;\">Por qu\u00e9 TELVE C.A.<\u002Fdiv>\n        <h2 style=\"font-family:'Anton',sans-serif;font-size:40px;text-transform:uppercase;font-weight:400;line-height:1.05;margin:0 0 18px;\">Medio siglo de oficio, hierro y confianza.<\u002Fh2>\n        <p style=\"font-size:16px;line-height:1.6;color:#9aa1a9;margin:0 0 26px;\">Yo mismo reviso y atiendo cada equipo. Nada de intermediarios: contacto directo, dedicaci\u00f3n constante y una reparaci\u00f3n que aguanta el trabajo duro.<\u002Fp>\n        <span sc-camel-on-click=\"{{ goNosotros }}\" style=\"cursor:pointer;color:#f5b301;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:15px;\">Conoce la historia \u2192<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <!-- contact CTA -->\n    <div style=\"padding:76px 56px;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;\">\n      <div>\n        <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:14px;\">Ubicaci\u00f3n<\u002Fdiv>\n        <h2 style=\"font-family:'Anton',sans-serif;font-size:40px;text-transform:uppercase;font-weight:400;margin:0 0 14px;\">Visita el taller<\u002Fh2>\n        <p style=\"font-size:15.5px;color:#b7bdc4;line-height:1.6;margin:0 0 24px;\">Barrio Ajuro, Calle Columbo Silva,<br>Edificio TELVE N\u00b0 33.<\u002Fp>\n        <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;gap:9px;background:#25D366;color:#04210f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:15px 28px;border-radius:5px;\">Contactar por WhatsApp<\u002Fa>\n      <\u002Fdiv>\n      <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);min-height:250px;border-radius:8px;display:flex;align-items:center;justify-content:center;\">\n        <span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;color:#7a828b;background:#1a1c1fcc;padding:8px 14px;border-radius:6px;\">mapa \u00b7 ubicaci\u00f3n del taller<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- ============================= SERVICIOS ============================= -->\n  <sc-if value=\"{{ isServicios }}\" hint-placeholder-val=\"{{ false }}\">\n  <div>\n    <div style=\"position:relative;padding:76px 56px 60px;background:linear-gradient(160deg,#26292e 0%,#1a1c1f 60%);\">\n      <div style=\"position:absolute;top:0;left:0;right:0;height:14px;background:repeating-linear-gradient(45deg,#f5b301,#f5b301 18px,#1a1c1f 18px,#1a1c1f 36px);\"><\u002Fdiv>\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:16px;\">Servicios<\u002Fdiv>\n      <h1 style=\"font-family:'Anton',sans-serif;font-size:62px;text-transform:uppercase;font-weight:400;margin:0 0 16px;line-height:1;\">Todo lo que reparamos<\u002Fh1>\n      <p style=\"font-size:18px;color:#b7bdc4;max-width:600px;margin:0;line-height:1.55;\">Soluciones electromec\u00e1nicas para industria, empresas, entidades p\u00fablicas y hogares.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"max-width:1180px;margin:0 auto;padding:72px 56px;display:flex;flex-direction:column;gap:24px;\">\n      <div style=\"display:grid;grid-template-columns:280px 1fr;gap:36px;background:#22262b;border:1px solid #2f343a;border-radius:10px;overflow:hidden;border-left:4px solid #f5b301;\">\n        <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);display:flex;align-items:center;justify-content:center;min-height:220px;\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7a828b;background:#22262bcc;padding:7px 12px;border-radius:6px;\">foto \u00b7 rebobinado<\u002Fspan><\u002Fdiv>\n        <div style=\"padding:34px 34px 34px 0;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:10px;\">01<\u002Fdiv>\n          <h2 style=\"font-family:'Oswald',sans-serif;font-size:28px;font-weight:700;text-transform:uppercase;margin:0 0 12px;\">Rebobinado y reparaci\u00f3n de motores<\u002Fh2>\n          <p style=\"font-size:15.5px;color:#9aa1a9;line-height:1.6;margin:0 0 16px;max-width:640px;\">Reparaci\u00f3n integral y rebobinado de motores el\u00e9ctricos monof\u00e1sicos y trif\u00e1sicos, de cualquier potencia. Revisi\u00f3n de devanados, cambio de rodamientos y pruebas de funcionamiento antes de la entrega.<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;color:#c9cfd6;\">\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Monof\u00e1sico<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Trif\u00e1sico<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Bobinado nuevo<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:280px 1fr;gap:36px;background:#22262b;border:1px solid #2f343a;border-radius:10px;overflow:hidden;border-left:4px solid #f5b301;\">\n        <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);display:flex;align-items:center;justify-content:center;min-height:220px;\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7a828b;background:#22262bcc;padding:7px 12px;border-radius:6px;\">foto \u00b7 mantenimiento<\u002Fspan><\u002Fdiv>\n        <div style=\"padding:34px 34px 34px 0;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:10px;\">02<\u002Fdiv>\n          <h2 style=\"font-family:'Oswald',sans-serif;font-size:28px;font-weight:700;text-transform:uppercase;margin:0 0 12px;\">Mantenimiento preventivo y correctivo<\u002Fh2>\n          <p style=\"font-size:15.5px;color:#9aa1a9;line-height:1.6;margin:0 0 16px;max-width:640px;\">Planes de mantenimiento para mantener tus equipos operando sin sorpresas. Inspecci\u00f3n, limpieza, lubricaci\u00f3n y correcci\u00f3n de fallas para evitar paradas costosas en tu operaci\u00f3n.<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;color:#c9cfd6;\">\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Preventivo<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Correctivo<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Diagn\u00f3stico<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:280px 1fr;gap:36px;background:#22262b;border:1px solid #2f343a;border-radius:10px;overflow:hidden;border-left:4px solid #f5b301;\">\n        <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);display:flex;align-items:center;justify-content:center;min-height:220px;\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;color:#7a828b;background:#22262bcc;padding:7px 12px;border-radius:6px;\">foto \u00b7 equipos<\u002Fspan><\u002Fdiv>\n        <div style=\"padding:34px 34px 34px 0;\">\n          <div style=\"font-family:'Anton',sans-serif;font-size:15px;color:#f5b301;margin-bottom:10px;\">03<\u002Fdiv>\n          <h2 style=\"font-family:'Oswald',sans-serif;font-size:28px;font-weight:700;text-transform:uppercase;margin:0 0 12px;\">Equipos electromec\u00e1nicos<\u002Fh2>\n          <p style=\"font-size:15.5px;color:#9aa1a9;line-height:1.6;margin:0 0 16px;max-width:640px;\">Diagn\u00f3stico, pruebas y reparaci\u00f3n de equipos y sistemas electromec\u00e1nicos. Localizamos la falla, la reparamos y verificamos el equipo completo antes de devolverlo a servicio.<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;color:#c9cfd6;\">\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Diagn\u00f3stico<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Pruebas<\u002Fspan>\n            <span style=\"border:1px solid #3a3f45;border-radius:4px;padding:6px 12px;\">Reparaci\u00f3n<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <!-- proceso -->\n    <div style=\"background:#141619;border-top:1px solid #2c3036;padding:72px 56px;\">\n      <div style=\"max-width:1180px;margin:0 auto;\">\n        <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:12px;\">C\u00f3mo trabajamos<\u002Fdiv>\n        <h2 style=\"font-family:'Anton',sans-serif;font-size:40px;text-transform:uppercase;font-weight:400;margin:0 0 40px;\">El proceso<\u002Fh2>\n        <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:20px;\">\n          <div style=\"padding:28px;border-top:3px solid #f5b301;background:#22262b;border-radius:0 0 8px 8px;\"><div style=\"font-family:'Anton',sans-serif;font-size:40px;color:#3a3f45;line-height:1;margin-bottom:12px;\">01<\u002Fdiv><h3 style=\"font-family:'Oswald',sans-serif;font-size:20px;text-transform:uppercase;font-weight:600;margin:0 0 8px;\">Revisi\u00f3n y diagn\u00f3stico<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Recibimos el equipo y detectamos la falla real, sin adivinar.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:28px;border-top:3px solid #f5b301;background:#22262b;border-radius:0 0 8px 8px;\"><div style=\"font-family:'Anton',sans-serif;font-size:40px;color:#3a3f45;line-height:1;margin-bottom:12px;\">02<\u002Fdiv><h3 style=\"font-family:'Oswald',sans-serif;font-size:20px;text-transform:uppercase;font-weight:600;margin:0 0 8px;\">Reparaci\u00f3n<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Ejecutamos el trabajo con dedicaci\u00f3n y materiales de calidad.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:28px;border-top:3px solid #f5b301;background:#22262b;border-radius:0 0 8px 8px;\"><div style=\"font-family:'Anton',sans-serif;font-size:40px;color:#3a3f45;line-height:1;margin-bottom:12px;\">03<\u002Fdiv><h3 style=\"font-family:'Oswald',sans-serif;font-size:20px;text-transform:uppercase;font-weight:600;margin:0 0 8px;\">Pruebas y entrega<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Probamos el equipo funcionando antes de entregarlo.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"text-align:center;padding:64px 56px;\">\n      <h2 style=\"font-family:'Anton',sans-serif;font-size:36px;text-transform:uppercase;font-weight:400;margin:0 0 20px;\">\u00bfTu motor necesita servicio?<\u002Fh2>\n      <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;gap:9px;background:#f5b301;color:#1a1c1f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:16px 32px;border-radius:5px;\">Cotiza por WhatsApp<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- ============================= NOSOTROS ============================= -->\n  <sc-if value=\"{{ isNosotros }}\" hint-placeholder-val=\"{{ false }}\">\n  <div>\n    <div style=\"position:relative;padding:76px 56px 60px;background:linear-gradient(160deg,#26292e 0%,#1a1c1f 60%);\">\n      <div style=\"position:absolute;top:0;left:0;right:0;height:14px;background:repeating-linear-gradient(45deg,#f5b301,#f5b301 18px,#1a1c1f 18px,#1a1c1f 36px);\"><\u002Fdiv>\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:16px;\">Nosotros<\u002Fdiv>\n      <h1 style=\"font-family:'Anton',sans-serif;font-size:62px;text-transform:uppercase;font-weight:400;margin:0;line-height:1;max-width:820px;\">M\u00e1s de 50 a\u00f1os reparando motores<\u002Fh1>\n    <\u002Fdiv>\n    <div style=\"max-width:1180px;margin:0 auto;padding:72px 56px;display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center;\">\n      <div>\n        <h2 style=\"font-family:'Anton',sans-serif;font-size:34px;text-transform:uppercase;font-weight:400;line-height:1.08;margin:0 0 20px;\">Un oficio de toda la vida.<\u002Fh2>\n        <p style=\"font-size:16.5px;color:#b7bdc4;line-height:1.65;margin:0 0 18px;\">Cuento con m\u00e1s de 50 a\u00f1os de experiencia que me respaldan. En todo este tiempo he reparado motores y equipos electromec\u00e1nicos para industrias, empresas, entidades p\u00fablicas y hogares.<\u002Fp>\n        <p style=\"font-size:16.5px;color:#9aa1a9;line-height:1.65;margin:0;\">Mi punto m\u00e1s fuerte es el trato directo con el cliente. Soy yo mismo quien atiende personalmente cada trabajo, lo que me permite tener un mayor tacto con lo que necesitas y ofrecerte un servicio personalizado con dedicaci\u00f3n constante.<\u002Fp>\n      <\u002Fdiv>\n      <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);min-height:380px;border-radius:10px;display:flex;align-items:center;justify-content:center;\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;color:#7a828b;background:#1a1c1fcc;padding:8px 14px;border-radius:6px;\">foto \u00b7 retrato del due\u00f1o en el taller<\u002Fspan><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background:#141619;border-top:1px solid #2c3036;border-bottom:1px solid #2c3036;padding:72px 56px;\">\n      <div style=\"max-width:1180px;margin:0 auto;\">\n        <h2 style=\"font-family:'Anton',sans-serif;font-size:36px;text-transform:uppercase;font-weight:400;margin:0 0 40px;text-align:center;\">Lo que me diferencia<\u002Fh2>\n        <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:20px;\">\n          <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\"><h3 style=\"font-family:'Oswald',sans-serif;font-size:22px;text-transform:uppercase;font-weight:600;margin:0 0 10px;\">+50 a\u00f1os<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Experiencia real que respalda cada reparaci\u00f3n.<\u002Fp><\u002Fdiv>\n          <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\"><h3 style=\"font-family:'Oswald',sans-serif;font-size:22px;text-transform:uppercase;font-weight:600;margin:0 0 10px;\">Trato directo<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Hablas conmigo, no con intermediarios.<\u002Fp><\u002Fdiv>\n          <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:32px;border-top:3px solid #f5b301;\"><h3 style=\"font-family:'Oswald',sans-serif;font-size:22px;text-transform:uppercase;font-weight:600;margin:0 0 10px;\">Dedicaci\u00f3n<\u002Fh3><p style=\"font-size:14.5px;color:#9aa1a9;line-height:1.55;margin:0;\">Servicio personalizado y atenci\u00f3n constante.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"text-align:center;padding:64px 56px;\">\n      <h2 style=\"font-family:'Anton',sans-serif;font-size:36px;text-transform:uppercase;font-weight:400;margin:0 0 20px;\">Hablemos de tu equipo<\u002Fh2>\n      <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;gap:9px;background:#25D366;color:#04210f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:16px 32px;border-radius:5px;\">Escr\u00edbenos por WhatsApp<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- ============================= CONTACTO ============================= -->\n  <sc-if value=\"{{ isContacto }}\" hint-placeholder-val=\"{{ false }}\">\n  <div>\n    <div style=\"position:relative;padding:76px 56px 60px;background:linear-gradient(160deg,#26292e 0%,#1a1c1f 60%);\">\n      <div style=\"position:absolute;top:0;left:0;right:0;height:14px;background:repeating-linear-gradient(45deg,#f5b301,#f5b301 18px,#1a1c1f 18px,#1a1c1f 36px);\"><\u002Fdiv>\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.2em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:16px;\">Contacto<\u002Fdiv>\n      <h1 style=\"font-family:'Anton',sans-serif;font-size:62px;text-transform:uppercase;font-weight:400;margin:0 0 16px;line-height:1;\">Hablemos<\u002Fh1>\n      <p style=\"font-size:18px;color:#b7bdc4;max-width:560px;margin:0;line-height:1.55;\">Escr\u00edbenos por WhatsApp o vis\u00edtanos en el taller. Te atiende directamente el due\u00f1o.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"max-width:1180px;margin:0 auto;padding:72px 56px;display:grid;grid-template-columns:1fr 1fr;gap:48px;\">\n      <div style=\"display:flex;flex-direction:column;gap:22px;\">\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:26px 28px;border-left:4px solid #f5b301;\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:8px;\">Direcci\u00f3n<\u002Fdiv>\n          <div style=\"font-size:16px;color:#eceff2;line-height:1.5;\">Barrio Ajuro, Calle Columbo Silva,<br>Edificio TELVE N\u00b0 33.<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:26px 28px;border-left:4px solid #f5b301;\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:8px;\">WhatsApp / Tel\u00e9fono<\u002Fdiv>\n          <div style=\"font-size:16px;color:#eceff2;line-height:1.5;\">+00 000 000 0000 <span style=\"color:#7a828b;font-family:'IBM Plex Mono',monospace;font-size:12px;\">(agregar n\u00famero real)<\u002Fspan><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:26px 28px;border-left:4px solid #f5b301;\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#f5b301;font-weight:600;margin-bottom:8px;\">Horario<\u002Fdiv>\n          <div style=\"font-size:16px;color:#eceff2;line-height:1.5;\">Lun \u2013 Vie \u00b7 8:00 a 17:00 <span style=\"color:#7a828b;font-family:'IBM Plex Mono',monospace;font-size:12px;\">(ajustar)<\u002Fspan><\u002Fdiv>\n        <\u002Fdiv>\n        <a href=\"https://wa.me/\" target=\"_blank\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:9px;background:#25D366;color:#04210f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:16px;padding:17px 28px;border-radius:5px;\">Abrir chat de WhatsApp<\u002Fa>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:16px;\">\n        <div style=\"background:repeating-linear-gradient(45deg,#24272c,#24272c 14px,#1e2126 14px,#1e2126 28px);min-height:220px;border-radius:8px;display:flex;align-items:center;justify-content:center;\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:13px;color:#7a828b;background:#1a1c1fcc;padding:8px 14px;border-radius:6px;\">mapa \u00b7 ubicaci\u00f3n del taller<\u002Fspan><\u002Fdiv>\n        <div style=\"background:#22262b;border:1px solid #2f343a;border-radius:8px;padding:28px;\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:18px;text-transform:uppercase;font-weight:600;margin-bottom:18px;\">Env\u00edanos un mensaje<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:12px;\">\n            <input placeholder=\"Nombre\" style=\"background:#1a1c1f;border:1px solid #3a3f45;border-radius:6px;padding:13px 14px;color:#eceff2;font-family:'Barlow';font-size:15px;outline:none;\">\n            <input placeholder=\"Tel\u00e9fono o WhatsApp\" style=\"background:#1a1c1f;border:1px solid #3a3f45;border-radius:6px;padding:13px 14px;color:#eceff2;font-family:'Barlow';font-size:15px;outline:none;\">\n            <textarea placeholder=\"\u00bfQu\u00e9 equipo necesitas reparar?\" rows=\"4\" style=\"background:#1a1c1f;border:1px solid #3a3f45;border-radius:6px;padding:13px 14px;color:#eceff2;font-family:'Barlow';font-size:15px;outline:none;resize:vertical;\"><\u002Ftextarea>\n            <span style=\"cursor:pointer;display:inline-flex;align-items:center;justify-content:center;background:#f5b301;color:#1a1c1f;font-family:'Oswald',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;font-size:15px;padding:14px;border-radius:6px;\">Enviar<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <!-- ===== FOOTER ===== -->\n  <div style=\"background:#0f1113;color:#7a828b;padding:40px 56px;display:flex;justify-content:space-between;align-items:center;font-size:13px;border-top:2px solid #f5b301;flex-wrap:wrap;gap:16px;\">\n    <div style=\"display:flex;flex-direction:column;gap:4px;\">\n      <span style=\"font-family:'Anton',sans-serif;font-size:24px;color:#fff;letter-spacing:0.03em;\">TELVE C.A.<\u002Fspan>\n      <span style=\"font-family:'Oswald',sans-serif;letter-spacing:0.06em;text-transform:uppercase;font-size:12px;\">Barrio Ajuro, Calle Columbo Silva, Edificio TELVE N\u00b0 33<\u002Fspan>\n    <\u002Fdiv>\n    <span style=\"font-family:'Oswald',sans-serif;letter-spacing:0.06em;text-transform:uppercase;\">\u00a9 2026 TELVE C.A. \u00b7 Motores el\u00e9ctricos \u00b7 Equipos electromec\u00e1nicos<\u002Fspan>\n  <\u002Fdiv>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { page: 'inicio' };\n  go(p) {\n    this.setState({ page: p });\n    try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch (e) {}\n  }\n  renderVals() {\n    const p = this.state.page;\n    const active = '#f5b301', idle = '#b7bdc4';\n    return {\n      isInicio: p === 'inicio',\n      isServicios: p === 'servicios',\n      isNosotros: p === 'nosotros',\n      isContacto: p === 'contacto',\n      cInicio: p === 'inicio' ? active : idle,\n      cServicios: p === 'servicios' ? active : idle,\n      cNosotros: p === 'nosotros' ? active : idle,\n      cContacto: p === 'contacto' ? active : idle,\n      goInicio: () => this.go('inicio'),\n      goServicios: () => this.go('servicios'),\n      goNosotros: () => this.go('nosotros'),\n      goContacto: () => this.go('contacto'),\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"</script>
</body>
</html>