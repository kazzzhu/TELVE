  <script type="__bundler/template">"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"a3cccb8b-3f67-4b45-8e85-029e3d36cc8c\"><\u002Fscript>\n\n<\u002Fhead>\n<body>\n<style id=\"r-responsive\">\n/* ===== RESPONSIVE OVERRIDES \u2014 TELVE C.A. ===== */\n/* Inline styles win over classes, so every rule uses attribute selectors + !important. */\n\n/* Smooth horizontal safety on all screens */\nhtml, body { max-width: 100%; overflow-x: hidden; }\nimg, svg, video { max-width: 100%; height: auto; }\n\n/* ---------- Mobile menu toggle (injected by script) ---------- */\n#r-burger { display: none; }\n@media (max-width: 860px) {\n  #r-burger {\n    display: inline-flex !important; align-items: center; justify-content: center;\n    background: transparent; border: 2px solid #3a3f45; border-radius: 6px;\n    width: 44px; height: 40px; cursor: pointer; padding: 0;\n  }\n  #r-burger span { display:block; width:20px; height:2px; background:#f5b301; position:relative; }\n  #r-burger span::before, #r-burger span::after {\n    content:\"\"; position:absolute; left:0; width:20px; height:2px; background:#f5b301;\n  }\n  #r-burger span::before { top:-6px; } #r-burger span::after { top:6px; }\n\n  /* Nav becomes column; links hidden until toggled */\n  [style*=\"justify-content:space-between\"][style*=\"padding:16px 56px\"][style*=\"border-bottom:2px solid #f5b301\"] {\n    flex-wrap: wrap !important; padding: 14px 20px !important;\n  }\n  [data-r-links] {\n    display: none !important; width: 100% !important; flex-direction: column !important;\n    align-items: flex-start !important; gap: 6px !important; margin-top: 12px !important;\n  }\n  [data-r-links].r-open { display: flex !important; }\n  [data-r-links] a[href*=\"wa.me\"] { width: 100%; justify-content: center; margin-top: 6px; }\n}\n\n/* ---------- TABLET (<= 900px) ---------- */\n@media (max-width: 900px) {\n  /* Reduce big side padding everywhere */\n  [style*=\"padding:96px 56px 88px\"] { padding: 56px 24px 48px !important; }\n  [style*=\"padding:80px 56px\"]      { padding: 56px 24px !important; }\n  [style*=\"padding:76px 56px\"]      { padding: 52px 24px !important; }\n  [style*=\"padding:72px 56px\"]      { padding: 52px 24px !important; }\n  [style*=\"padding:64px 56px\"]      { padding: 48px 24px !important; }\n  [style*=\"padding:40px 56px\"]      { padding: 32px 20px !important; }\n\n  /* 4-col spec strip -> 2 cols */\n  [style*=\"grid-template-columns:repeat(4,1fr)\"] {\n    grid-template-columns: repeat(2, 1fr) !important;\n  }\n  [style*=\"grid-template-columns:repeat(4,1fr)\"] > div {\n    padding: 22px 24px !important; border-right: none !important;\n    border-bottom: 1px solid #2c3036 !important;\n  }\n\n  /* 3-col card grids -> 1 col on tablet? keep 2 for balance, 1 on phone below */\n  [style*=\"grid-template-columns:repeat(3,1fr)\"] {\n    grid-template-columns: repeat(2, 1fr) !important;\n  }\n\n  /* Two-column split sections -> stack */\n  [style*=\"grid-template-columns:1fr 1.05fr\"],\n  [style*=\"grid-template-columns:1.1fr 1fr\"],\n  [style*=\"grid-template-columns:1fr 1fr\"] {\n    grid-template-columns: 1fr !important; gap: 28px !important;\n  }\n  /* Reduce padding on the \"why us\" text panel when stacked */\n  [style*=\"padding:76px 56px\"][style*=\"flex-direction:column\"] { padding: 40px 24px !important; }\n\n  /* Service rows: image 280px + text -> stack */\n  [style*=\"grid-template-columns:280px 1fr\"] {\n    grid-template-columns: 1fr !important;\n  }\n  [style*=\"grid-template-columns:280px 1fr\"] > div:last-child {\n    padding: 28px !important;\n  }\n\n  /* Headings scale down */\n  h1[style*=\"font-size:78px\"] { font-size: 44px !important; }\n  h1[style*=\"font-size:62px\"] { font-size: 38px !important; }\n  h2[style*=\"font-size:46px\"] { font-size: 32px !important; }\n  h2[style*=\"font-size:40px\"] { font-size: 28px !important; }\n  h2[style*=\"font-size:36px\"] { font-size: 26px !important; }\n  h2[style*=\"font-size:34px\"] { font-size: 26px !important; }\n  [style*=\"font-size:78px\"]:not(h1) { font-size: 44px !important; }\n\n  /* Footer stacks */\n  [style*=\"padding:40px 56px\"][style*=\"justify-content:space-between\"] {\n    flex-direction: column !important; align-items: flex-start !important; text-align: left;\n  }\n}\n\n/* ---------- PHONE (<= 560px) ---------- */\n@media (max-width: 560px) {\n  [style*=\"grid-template-columns:repeat(4,1fr)\"] { grid-template-columns: 1fr 1fr !important; }\n  [style*=\"grid-template-columns:repeat(3,1fr)\"] { grid-template-columns: 1fr !important; }\n\n  /* Hero buttons stack full width */\n  [style*=\"padding:96px 56px 88px\"] [style*=\"display:flex\"][style*=\"gap:14px\"] {\n    flex-direction: column !important; align-items: stretch !important;\n  }\n  [style*=\"padding:96px 56px 88px\"] a[href*=\"wa.me\"],\n  [style*=\"padding:96px 56px 88px\"] [sc-camel-on-click] {\n    justify-content: center !important; text-align: center;\n  }\n\n  h1[style*=\"font-size:78px\"] { font-size: 34px !important; }\n  h1[style*=\"font-size:62px\"] { font-size: 30px !important; }\n  h2[style*=\"font-size:46px\"] { font-size: 26px !important; }\n\n  p[style*=\"font-size:20px\"] { font-size: 16px !important; }\n  p[style*=\"font-size:18px\"] { font-size: 15px !important; }\n\n  /* Contact form buttons full width already; tighten card padding */\n  [style*=\"padding:26px 28px\"] { padding: 20px !important; }\n}\n\n<\u002Fstyle>\n<script id=\"r-menu-script\">\n(function(){\n  function bind(){\n    var b=document.getElementById(\"r-burger\");\n    var links=document.querySelector(\"[data-r-links]\");\n    if(!b||!links){return;}\n    if(b.__bound){return;} b.__bound=true;\n    b.addEventListener(\"click\",function(e){e.stopPropagation();links.classList.toggle(\"r-open\");});\n    links.addEventListener(\"click\",function(e){\n      var t=e.target;\n      if(t.closest(\"[sc-camel-on-click]\")||t.closest(\"a\")){links.classList.remove(\"r-open\");}\n    });\n  }\n  // React re-renders may replace nodes; rebind periodically + on load.\n  document.addEventListener(\"DOMContentLoaded\",bind);\n  setInterval(bind,600);\n})();\n<\u002Fscript>\n\n<x-dc>\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<style>/* vietnamese */\n@font-face {\n  font-family: 'Anton';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"0905f41b-861b-4cb7-a3e6-4ef6b7ec6093\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Anton';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"5c7a640d-e3d2-4d89-9e24-4a7b961abb45\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Anton';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"a4902d89-ec54-49e3-8f23-250fab2e5040\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Barlow';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"2d3807f4-a728-4d14-a0d8-802812caa4e1\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-fam